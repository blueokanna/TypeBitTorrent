#!/bin/bash
# fnOS install callback.
#
# `wizard/install` collects the WebUI password; fnOS hands wizard answers to
# the lifecycle scripts as environment variables named after the wizard
# `field` (developer.fnnas.com/docs/core-concepts/wizard). The value is stashed
# so `cmd/main` can apply it exactly once, on the first start — after that the
# client owns the (PBKDF2-hashed) password and the user can change it in the
# WebUI without the install answer overriding it at every boot.
set -u

APPDIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
VAR="${TRIM_PKGVAR:-${APPDIR}/var}"
ETC="${TRIM_PKGETC:-${APPDIR}/etc}"
CONF="${ETC}/typebit.conf"
mkdir -p "$VAR" "$ETC" 2>/dev/null || true

if [ -n "${wizard_webui_password:-}" ]; then
    umask 077
    printf '%s' "$wizard_webui_password" >"${VAR}/initial-password.txt"
    echo "$(date '+%F %T') install: WebUI password taken from the install wizard" \
        >>"${VAR}/typebit.log" 2>/dev/null || true
fi

# Create the app's own settings file once, so `cmd/main` treats it as the
# authoritative (if empty) answer instead of guessing, and so the App Center
# settings form (wizard/config) has a file to write.
if [ ! -f "$CONF" ]; then
    {
        printf '# TypeBitTorrent — written by the fnOS App Center settings form.\n'
        printf '# download_dir=   # 下载保存目录；留空 = 授权目录 → 共享文件夹 → 应用数据目录\n'
    } >"$CONF" 2>/dev/null || true
fi
exit 0
