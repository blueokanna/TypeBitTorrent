#!/bin/bash
# fnOS lifecycle entry point for TypeBitTorrent.
#
# Contract (developer.fnnas.com/docs/core-concepts/framework):
#   start  -> 0 when the service runs, 1 on a real failure (idempotent)
#   stop   -> 0 (idempotent)
#   status -> 0 running, 3 not running, 1 on a real failure
#
# Layout: fnOS unpacks the *contents* of the package's `app/` payload into
# `TRIM_APPDEST` (developer.fnnas.com/docs/core-concepts/environment-variables),
# so the jpackage launcher lands at `$TRIM_APPDEST/bin/TypeBitTorrent` with its
# `lib/` and `runtime/` siblings — there is no extra `app/` path component.
#
# The package ships a self-contained app image (its own JRE), so `manifest`
# declares no dependency and the NAS needs nothing pre-installed.
#
# Environment provided by fnOS:
#   TRIM_APPDEST           installed payload root (/var/apps/typebittorrent/target)
#   TRIM_PKGVAR            run data; survives restarts and upgrades
#   TRIM_PKGTMP            scratch space
#   TRIM_TEMP_LOGFILE      file whose content fnOS shows to the user on failure
#   TRIM_SERVICE_PORT      the port declared in `manifest` (18881)
#   TRIM_DATA_SHARE_PATHS  ':'-separated paths of the shares in `config/resource`
set -u

APPNAME="typebittorrent"
# Fall back to the *installed* layout (`<app dir>/target`, where `<app dir>` is
# the parent of the `cmd/` directory holding these scripts) so a lifecycle call
# that arrives without TRIM_APPDEST still finds the payload instead of inventing
# a path that never exists. The package-source layout is only a last resort.
APPDIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
if [ -n "${TRIM_APPDEST:-}" ]; then
    APPDEST="$TRIM_APPDEST"
elif [ -x "${APPDIR}/target/bin/TypeBitTorrent" ]; then
    APPDEST="${APPDIR}/target"
else
    APPDEST="${APPDIR}/app"
fi
BIN="${APPDEST}/bin/TypeBitTorrent"
VAR="${TRIM_PKGVAR:-${APPDIR}/var}"
TMP="${TRIM_PKGTMP:-${APPDIR}/tmp}"
PIDFILE="${VAR}/typebit.pid"
LOGFILE="${VAR}/typebit.log"
# First-run credentials: `cmd/install_callback` writes the install-wizard answer
# here, `start` applies it exactly once and then records that it did — so a
# password change made later in the WebUI is not overwritten at every boot.
INITIAL_PW_FILE="${VAR}/initial-password.txt"
PW_APPLIED="${VAR}/.pw-applied"
PORT="${TRIM_SERVICE_PORT:-18881}"
START_TIMEOUT="${TYPEBIT_START_TIMEOUT:-60}"
STOP_TIMEOUT="${TYPEBIT_STOP_TIMEOUT:-20}"

# The first share declared in `config/resource` is the download folder: fnOS
# creates it at install time and hands its path over in TRIM_DATA_SHARE_PATHS.
DOWNLOAD_DIR="$(printf '%s' "${TRIM_DATA_SHARE_PATHS:-}" | cut -d: -f1)"
[ -n "$DOWNLOAD_DIR" ] || DOWNLOAD_DIR="${VAR}/downloads"

log() { echo "$(date '+%F %T') $*" >>"$LOGFILE" 2>/dev/null || true; }

# fnOS shows this file to the user when a lifecycle step fails, so every
# failure has to leave a short, actionable line (plus the tail of the log).
user_error() {
    log "ERROR: $1"
    [ -n "${TRIM_TEMP_LOGFILE:-}" ] || return 0
    {
        printf '%s\n' "$1"
        printf -- '--- %s ---\n' "$LOGFILE"
        tail -n 20 "$LOGFILE" 2>/dev/null
    } >"$TRIM_TEMP_LOGFILE" 2>/dev/null || true
}

# True when the command line of $1 belongs to this application. The launcher is
# referred to by three different strings depending on how it was started
# (`$APPDEST/bin/TypeBitTorrent`, a symlinked install root, or a bare name), and
# a wrong answer here is expensive: fnOS reads `status` as "the app is stopped",
# offers to start a second instance, and that instance cannot bind the port — so
# the app ends up permanently marked as stopped.
is_our_process() {
    local pid="$1" line
    [ -r "/proc/$pid/cmdline" ] || return 0
    line="$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null)"
    [ -n "$line" ] || return 1
    case "$line" in
        *"$BIN"*) return 0 ;;
        *TypeBitTorrent*) return 0 ;;
    esac
    return 1
}

is_running() {
    [ -f "$PIDFILE" ] || return 1
    local pid
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # A reboot can hand a stale pid to an unrelated process.
    is_our_process "$pid" || return 1
    return 0
}

# Pids of live instances that the pid file does not know about: the result of a
# crash-then-restart, an upgrade, or a `stop` that lost a race. They hold the
# WebUI port, which is why the next start must not simply wave them through.
foreign_pids() {
    local d pid exe
    for d in /proc/[0-9]*; do
        pid="${d#/proc/}"
        [ "$pid" != "$$" ] || continue
        [ -r "$d/cmdline" ] || continue
        exe="$(tr '\0' '\n' <"$d/cmdline" 2>/dev/null | head -n 1)"
        case "$exe" in
            */bin/TypeBitTorrent) printf '%s\n' "$pid" ;;
        esac
    done
}

# Pure-bash TCP probe — no curl/wget dependency on the NAS.
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$PORT") >/dev/null 2>&1; }

# 20-char [A-Za-z0-9] secret; the client would otherwise invent its own and
# print it to a log file that the NAS UI never shows.
gen_password() { LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 20; }

start() {
    if is_running; then
        return 0
    fi
    # Distinguish "never ran" from "died": the pid file surviving with a dead
    # pid is exactly what an unexpected shutdown looks like, and it is the one
    # line the user needs when reporting it.
    if [ -f "$PIDFILE" ]; then
        local stale
        stale="$(cat "$PIDFILE" 2>/dev/null || true)"
        log "previous instance${stale:+ (pid $stale)} is gone; check $LOGFILE for a crash before it stopped"
        rm -f "$PIDFILE"
    fi
    mkdir -p "$VAR" "$TMP" "$DOWNLOAD_DIR"
    if [ ! -x "$BIN" ]; then
        user_error "找不到可执行文件 $BIN：安装似乎不完整，请重新安装应用。"
        return 1
    fi

    # An orphan from an earlier run still holds the WebUI port; without this the
    # new instance cannot bind and gets reported as "启动失败" forever.
    local -a orphans=()
    while read -r opid; do
        [ -n "$opid" ] && orphans+=("$opid")
    done < <(foreign_pids)
    if [ "${#orphans[@]}" -gt 0 ]; then
        log "cleaning up orphaned instance(s): ${orphans[*]}"
        kill "${orphans[@]}" 2>/dev/null
        local owait=0
        while [ "$owait" -lt 5 ]; do
            local alive=0
            for opid in "${orphans[@]}"; do kill -0 "$opid" 2>/dev/null && alive=1; done
            [ "$alive" -eq 0 ] && break
            sleep 1
            owait=$((owait + 1))
        done
        for opid in "${orphans[@]}"; do kill -9 "$opid" 2>/dev/null; done
    fi

    # Pre-flight: 18881 is the packaged default because 8080 is frequently
    # taken on a NAS. If something else already holds the port, say so now
    # instead of letting the client exit a minute later with a generic error.
    if port_open; then
        user_error "WebUI 端口 $PORT 已被其他程序占用，无法启动。请释放该端口，或同时把 manifest 的 service_port 与 app/ui/config 的 port 改成同一个空闲端口后重新安装。"
        return 1
    fi

    # `--frame-ancestors=*`: the App Center card is an iframe whose origin (the
    # NAS UI port) cannot be known at build time. Without it the WebUI's default
    # `frame-ancestors 'none'` renders the card blank.
    local -a args=(
        --headless
        --bind=0.0.0.0
        --port="$PORT"
        --data="$VAR"
        --downloads="$DOWNLOAD_DIR"
        --frame-ancestors='*'
    )

    # Apply the first-run password once (`appcenter-cli install-fpk` installs
    # without a form, hence the generate-and-keep fallback).
    local first_pw="" pw_arg=""
    if [ ! -f "$PW_APPLIED" ]; then
        if [ ! -s "$INITIAL_PW_FILE" ]; then
            umask 077
            gen_password >"$INITIAL_PW_FILE" 2>/dev/null || true
        fi
        first_pw="$(cat "$INITIAL_PW_FILE" 2>/dev/null || true)"
    fi
    # Passed through the environment, not argv: /proc/<pid>/environ is only
    # readable by the app user, while /proc/<pid>/cmdline is world-readable.
    local -a pw_env=()
    if [ -n "$first_pw" ]; then
        pw_env=(TYPEBIT_PASSWORD="$first_pw")
        pw_arg=" (首次密码来自 $INITIAL_PW_FILE)"
    fi

    log "starting: $BIN --headless --port=$PORT --data=$VAR --downloads=$DOWNLOAD_DIR$pw_arg"
    # The working directory is the data dir: an engine/JVM crash then writes
    # `hs_err_pid*.log` (and ${TRIM_PKGVAR}/core dumps) somewhere the user can
    # actually read, instead of inside a root-owned directory or "/".
    cd "$VAR" 2>/dev/null || true
    nohup env ${pw_env[@]+"${pw_env[@]}"} "$BIN" "${args[@]}" >>"$LOGFILE" 2>&1 &
    echo $! >"$PIDFILE"

    # Wait for the WebUI socket: the JVM and the engine worker need a moment on
    # a NAS CPU, and "the port is already taken" must not look like success
    # (the client exits with code 2 when it cannot bind).
    local waited=0
    while [ "$waited" -lt "$START_TIMEOUT" ]; do
        if ! is_running; then
            rm -f "$PIDFILE"
            user_error "TypeBitTorrent 启动失败（端口 $PORT 可能被占用），日志：$LOGFILE"
            return 1
        fi
        if port_open; then
            log "started pid $(cat "$PIDFILE"), WebUI on port $PORT"
            if [ -n "$first_pw" ]; then
                : >"$PW_APPLIED"
                log "initial WebUI password applied (stored in $INITIAL_PW_FILE; change it in 设置 → WebUI)"
            fi
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    log "warning: port $PORT did not open within ${START_TIMEOUT}s, process is alive — leaving it running"
    return 0
}

stop() {
    # Orphans are stopped too, otherwise the next start cannot bind the port and
    # fnOS marks a healthy install as "启动失败".
    local -a targets=()
    local opid
    if is_running; then
        targets+=("$(cat "$PIDFILE")")
    fi
    while read -r opid; do
        [ -n "$opid" ] && targets+=("$opid")
    done < <(foreign_pids)
    if [ "${#targets[@]}" -eq 0 ]; then
        rm -f "$PIDFILE"
        return 0
    fi
    # SIGTERM first: the client flushes resume data and joins the engine worker
    # before exiting, so a clean stop never loses progress.
    kill "${targets[@]}" 2>/dev/null
    local waited=0
    while [ "$waited" -lt "$STOP_TIMEOUT" ]; do
        local alive=0
        for opid in "${targets[@]}"; do kill -0 "$opid" 2>/dev/null && alive=1; done
        [ "$alive" -eq 0 ] && break
        sleep 1
        waited=$((waited + 1))
    done
    for opid in "${targets[@]}"; do
        if kill -0 "$opid" 2>/dev/null; then
            log "graceful stop timed out, sending SIGKILL to $opid"
            kill -9 "$opid" 2>/dev/null
        fi
    done
    rm -f "$PIDFILE"
    return 0
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    status)
        if is_running; then exit 0; else exit 3; fi
        ;;
    *)
        user_error "未知命令：${1:-}（支持 start / stop / status）"
        exit 1
        ;;
esac
