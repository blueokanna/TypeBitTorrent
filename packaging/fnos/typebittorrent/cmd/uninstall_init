#!/bin/bash
# fnOS uninstall init: stop the client before the payload is removed, so the
# engine flushes resume data instead of being deleted out from under itself.
#
# `cmd/main stop` is what knows about orphaned instances (a crash followed by a
# restart, or an interrupted upgrade) — killing only the process named by the
# pid file would leave one behind holding the WebUI port.
set -u

APPDIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
MAIN="$(cd "$(dirname "$0")" && pwd)/main"

if [ -f "$MAIN" ]; then
    bash "$MAIN" stop >/dev/null 2>&1 || true
fi
rm -f "${TRIM_PKGVAR:-${APPDIR}/var}/typebit.pid" 2>/dev/null || true
exit 0
