<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for 边下边播 (stream preview): torrent files (and their
  `.part` staged twins) live under the public Downloads directory or the
  app's own external files dir. The grant is per-URI and temporary — the
  player app only sees the exact file being previewed.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="external" path="." />
    <external-files-path name="app_external" path="." />
    <files-path name="app_files" path="." />
    <cache-path name="app_cache" path="." />
</paths>
