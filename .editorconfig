root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ij_kotlin_allow_trailing_comma = true

[*.rs]
indent_size = 4

[*.{md,toml,yml,yaml,json}]
indent_size = 4

[*.ps1]
indent_size = 4
